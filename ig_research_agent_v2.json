        "jsCode": "const raw = $input.first().json.message?.content?.[0]?.text || $input.first().json.choices?.[0]?.message?.content || '{}';\nlet parsed;\ntry {\n  parsed = JSON.parse(raw);\n} catch(e) {\n  parsed = { ai_report: raw, wealthy_report: raw };\n}\nreturn [{ json: parsed }];"
