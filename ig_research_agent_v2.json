    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst reels = items.map(i => i.json);\nreels.sort((a, b) => (b.videoPlayCount || 0) - (a.videoPlayCount || 0));\nconst top = reels.slice(0, 10);\nreturn top.map(r => ({ json: r }));"
      },
      "id": "sort-my-reels",
      "name": "Sort My Reels Top 10",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [700, 600]
    },
    {
      "parameters": {
        "jsCode": "const aiReels = $('Sort AI Competitors Top 15').all().map(i => i.json);\nconst wealthyReels = $('Sort Wealthy Competitors Top 15').all().map(i => i.json);\nconst myReels = $('Sort My Reels Top 10').all().map(i => i.json);\n\nconst formatReel = (r) => ({\n  url: r.url || r.shortCode || 'N/A',\n  caption: (r.caption || '').slice(0, 200),\n  views: r.videoPlayCount || 0,\n  likes: r.likesCount || 0,\n  comments: r.commentsCount || 0,\n  engagement: r.videoPlayCount > 0 ? (((r.likesCount || 0) + (r.commentsCount || 0)) / r.videoPlayCount * 100).toFixed(2) + '%' : '0%',\n  ownerUsername: r.ownerUsername || r.username || 'unknown',\n  timestamp: r.timestamp || r.takenAtTimestamp || 'unknown'\n});\n\nreturn [{\n  json: {\n    ai_competitors: aiReels.map(formatReel),\n    wealthy_competitors: wealthyReels.map(formatReel),\n    my_reels: myReels.map(formatReel)\n  }\n}];"
      },
      "id": "combine-data",
      "name": "Combine All Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [940, 400]
    },
