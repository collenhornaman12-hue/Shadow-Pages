    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst reels = items.map(i => i.json);\nreels.sort((a, b) => (b.videoPlayCount || 0) - (a.videoPlayCount || 0));\nconst top = reels.slice(0, 15);\nreturn top.map(r => ({ json: r }));"
      },
      "id": "sort-competitor-ai",
